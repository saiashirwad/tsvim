{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["lua-types/jit"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "tstl": {
    "luaTarget": "JIT",
    "noImplicitSelf": true,
    "luaLibImport": "require",
    "luaBundle": "init.lua",
    "luaBundleEntry": "src/init.ts",
    "noHeader": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
